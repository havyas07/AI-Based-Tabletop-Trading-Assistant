# AI Engine Configuration
# Supports OpenAI, Gemini, Groq, Anthropic or generic REST endpoints
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_PROVIDER=gemini
AI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent

# Optional Market Data API Key (yfinance does not require a key by default)
MARKET_DATA_API_KEY=

# Historical Price-Hit Analysis Settings
PRICE_HIT_TOLERANCE_PCT=0.5
DEFAULT_FUTURE_WINDOW_DAYS=5
